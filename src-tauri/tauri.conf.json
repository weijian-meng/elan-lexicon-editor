{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ELAN Lexicon Editor",
  "version": "0.3.0-beta.1",
  "identifier": "com.weijianmeng.elan-lexicon-editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ELAN Lexicon Editor",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "msi"
    ],
    "publisher": "Weijian Meng",
    "homepage": "https://github.com/weijian-meng/elan-lexicon-editor",
    "copyright": "Copyright (c) 2026 Weijian Meng",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "Desktop editor for ELAN-compatible XML lexicon files.",
    "longDescription": "ELAN Lexicon Editor is a desktop application for creating, editing, reviewing, and saving XML lexicon files compatible with ELAN lexicon data.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
